# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never exposed to the browser. Used solely by the historical
# import, which has to write backdated rows onto cycles that closed years ago.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who may sign in is the app_users table and nothing else. There is no list to
# keep in step here — add or remove a row in the database.

# --- Google Sheets mirror (optional) ---------------------------------------
# A service account with the Sheets API enabled. Share the target spreadsheet
# with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
# Keep the \n escapes in the private key exactly as Google gives them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID=

# Set this in production so only Vercel Cron can trigger the nightly refresh.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

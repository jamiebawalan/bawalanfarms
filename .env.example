# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by the import route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The three people allowed to sign in. Comma separated, lowercase.
# Must match allowed_emails in supabase/migrations/0003_rls.sql.
NEXT_PUBLIC_ALLOWED_EMAILS=owner@example.com,manager@example.com,husband@example.com

# Google Sheets mirror (Supabase edge function secrets, not needed for local dev)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID=
